.pp-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.pp-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.pp-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
  text-align: center;
}

.pp-desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #3a3a3c;
}

.pp-link {
  color: #34c759;
}

.pp-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.pp-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 0;
}

.pp-btn::after {
  border: none;
}

.pp-ghost {
  background: #f2f2f7;
  color: #3a3a3c;
}

.pp-primary {
  background: #34c759;
  color: #ffffff;
}

.pp-pressed {
  opacity: 0.75;
}
