.page { padding: 24rpx 32rpx 64rpx; }

/* ===== 表单分组卡 ===== */
.form-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}
.field { padding: 28rpx 0; }
.field-divider { border-top: 1rpx solid rgba(60,60,67,0.12); }
.label { font-size: 26rpx; font-weight: 600; color: #8e8e93; letter-spacing: 1rpx; margin-bottom: 16rpx; }
.req { color: #ff3b30; }

/* iOS 灰填充输入框 */
.input {
  background: #f2f2f7;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 29rpx;
  color: #1c1c1e;
}
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f2f2f7;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 29rpx;
  color: #1c1c1e;
  min-height: 200rpx;
}

/* 选择行 */
.picker-row {
  background: #f2f2f7;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.picker-value { font-size: 29rpx; color: #1c1c1e; }
.picker-arrow { color: #c7c7cc; font-size: 36rpx; line-height: 1; font-weight: 300; }

/* ===== 提交按钮（iOS 全宽胶囊） ===== */
.submit-btn {
  margin-top: 40rpx;
  text-align: center;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff;
  background: #34c759;
  border-radius: 28rpx;
  padding: 26rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(52,199,89,0.4);
  transition: all 0.12s ease;
}
.submit-pressed { background: #2db350; transform: scale(0.98); }
.submit-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #c7c7cc;
}
