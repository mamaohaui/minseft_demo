<!-- iOS 风搜索框：灰底填充 + 放大镜 -->
<view class="search-bar">
  <view class="field">
    <text class="field-icon">🔍</text>
    <input value="{{keyword}}" placeholder="搜索名称 / 品类关键词"
           confirm-type="search" bindconfirm="doSearch" bindinput="onInput" />
  </view>
  <text class="search-btn" hover-class="link-pressed" bindtap="doSearch">搜索</text>
</view>

<!-- 筛选区：iOS 分组卡 -->
<view class="filter-block">
  <view class="filter-row">
    <view class="filter-label">品类</view>
    <view class="chips">
      <view wx:for="{{categories}}" wx:key="*this"
            class="chip {{category === item ? 'chip-on' : ''}}"
            hover-class="chip-pressed" hover-stay-time="60"
            data-value="{{item}}" bindtap="toggleCategory">{{item}}</view>
    </view>
  </view>

  <view class="filter-row">
    <view class="filter-label">地点类型</view>
    <view class="chips">
      <view wx:for="{{spotTypes}}" wx:key="*this"
            class="chip {{spotType === item ? 'chip-on' : ''}}"
            hover-class="chip-pressed" hover-stay-time="60"
            data-value="{{item}}" bindtap="toggleSpotType">{{item}}</view>
    </view>
  </view>

  <view class="filter-row">
    <view class="filter-label">发布者</view>
    <view class="creator-field">
      <text class="field-icon">🔍</text>
      <input value="{{creator}}"
             placeholder="输入发布者昵称，搜 TA 公开发的地点"
             confirm-type="search" bindconfirm="doSearch" bindinput="onCreatorInput" />
    </view>
  </view>

  <view wx:if="{{hasCond}}" class="reset-line" hover-class="link-pressed" bindtap="resetAll">清空筛选 ✕</view>
</view>

<view wx:if="{{searching}}" class="hint">搜索中…</view>

<!-- 结果：iOS 分组卡 + 发丝线分隔 -->
<view class="result-card" wx:if="{{results.length}}">
  <view wx:for="{{results}}" wx:key="_id"
        class="item {{index > 0 ? 'item-divider' : ''}}"
        hover-class="row-pressed" hover-stay-time="80"
        data-id="{{item._id}}" bindtap="goDetail">
    <view class="item-main">
      <view class="t">{{item.current.title}}</view>
      <view class="s">{{item.current.category}} · {{item.current.timeSlot}} · {{item.current.feeType}}</view>
      <view class="creator">发布者：{{item.creatorName || '匿名摊友'}}</view>
    </view>
    <text class="arrow">›</text>
  </view>
</view>

<view wx:if="{{!searching && results.length === 0 && searched}}" class="empty">没有符合条件的摆摊点，换个条件试试</view>
<view wx:if="{{!searched}}" class="empty">输入关键词，或选择品类 / 地点类型 / 发布者</view>
