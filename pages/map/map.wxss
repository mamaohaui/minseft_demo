.map { width: 100%; height: 100vh; }

/* ===== 顶部中间：地区选择器（iOS 悬浮胶囊） ===== */
.region-btn {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  top: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 250rpx;
  height: 92rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,0.92);
  border-radius: 46rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12);
  z-index: 10;
  transition: transform 0.12s ease;
}
.region-icon { font-size: 26rpx; line-height: 1; }
.region-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1c1e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.region-caret { font-size: 20rpx; color: #8e8e93; line-height: 1; }

/* ===== 左上角：定位 / 刷新（Apple Maps 式悬浮圆钮） ===== */
.top-left-bar {
  position: fixed;
  left: 24rpx;
  top: 30rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}
.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 32rpx;
  color: #1c1c1e;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12);
  transition: transform 0.12s ease;
}
.ctrl-icon {
  font-size: 34rpx;
  color: #007aff;
  line-height: 1;
}
.ctrl-text {
  font-size: 20rpx;
  color: #8e8e93;
  margin-top: 6rpx;
}

/* ===== 右上角：图层按钮 ===== */
.layer-btn {
  position: fixed;
  right: 24rpx;
  top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12);
  z-index: 12;
  transition: transform 0.12s ease;
}
.layer-icon { font-size: 32rpx; color: #007aff; line-height: 1; }
.layer-text { font-size: 20rpx; color: #8e8e93; margin-top: 6rpx; }

/* 按下态：轻微缩放 + 提亮，iOS 按压质感 */
.btn-pressed {
  transform: scale(0.92);
  background: rgba(255,255,255,1);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* ===== 图层面板（iOS 弹出卡） ===== */
.layer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.25);
  z-index: 11;
}
.layer-panel {
  position: absolute;
  right: 24rpx;
  top: 140rpx;
  width: 420rpx;
  background: rgba(255,255,255,0.98);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.18);
  box-sizing: border-box;
  overflow: hidden;
}
.layer-panel-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8e8e93;
  margin-bottom: 4rpx;
}
.layer-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(60,60,67,0.12);
}
.layer-option:last-of-type { border-bottom: none; }
.layer-name { font-size: 30rpx; color: #1c1c1e; }

/* iOS 开关（systemGreen） */
.layer-switch {
  width: 92rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(120,120,128,0.32);
  position: relative;
  transition: background 0.2s;
}
.switch-on { background: #34c759; }
.layer-dot {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
  transition: transform 0.2s cubic-bezier(0.3, 1.2, 0.4, 1);
}
.switch-on .layer-dot { transform: translateX(36rpx); }

/* ===== 底部一行：搜索栏 + 发布按钮（iOS 胶囊） ===== */
.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 10;
}
.search-bar {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,0.94);
  border-radius: 46rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12);
  transition: transform 0.12s ease;
}
.search-icon { font-size: 28rpx; line-height: 1; }
.search-text { font-size: 28rpx; color: #8e8e93; }

.publish-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  background: #34c759;
  color: #fff;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx rgba(52,199,89,0.4);
  transition: transform 0.12s ease;
}
.publish-icon { font-size: 30rpx; line-height: 1; }

/* 按下态 */
.bar-pressed {
  transform: scale(0.98);
  background: rgba(255,255,255,1);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.publish-pressed {
  transform: scale(0.96);
  background: #2db350;
  box-shadow: 0 4rpx 12rpx rgba(52,199,89,0.3);
}

/* ===== 空态提示（iOS toast 胶囊） ===== */
.empty-tip {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  top: 150rpx;
  background: rgba(0,0,0,0.72);
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  z-index: 10;
  white-space: nowrap;
}
