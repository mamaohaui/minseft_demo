.map { width: 100%; height: 100vh; }

/* 右下角统一操作区：主发布按钮 + 定位/刷新图标按钮，纵向归整排列 */
.action-bar {
  position: fixed;
  right: 24rpx;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  z-index: 10;
}

/* 发布：唯一主入口，绿色胶囊 */
.publish-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #07c160;
  color: #fff;
  padding: 22rpx 36rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(7,193,96,0.4);
}
.publish-icon { font-size: 32rpx; line-height: 1; }

/* 定位/刷新：次级白色圆形图标按钮 */
.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  color: #333;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.15);
}
.ctrl-icon {
  font-size: 34rpx;
  color: #07c160;
  line-height: 1;
}
.ctrl-text {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

.empty-tip {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  top: 30rpx;
  background: rgba(0,0,0,0.7);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
  z-index: 10;
  white-space: nowrap;
}
