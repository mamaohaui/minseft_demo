.map { width: 100%; height: 100vh; }

/* 左上角：定位 / 刷新 圆形按钮 */
.top-left-bar {
  position: fixed;
  left: 24rpx;
  top: 30rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}
.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  color: #333;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.15);
}
.ctrl-icon {
  font-size: 34rpx;
  color: #07c160;
  line-height: 1;
}
.ctrl-text {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 右上角：图层按钮 */
.layer-btn {
  position: fixed;
  right: 24rpx;
  top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.15);
  z-index: 12;
}
.layer-icon { font-size: 32rpx; color: #07c160; line-height: 1; }
.layer-text { font-size: 20rpx; color: #666; margin-top: 4rpx; }

/* 图层面板 */
.layer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.25);
  z-index: 11;
}
.layer-panel {
  position: absolute;
  right: 24rpx;
  top: 140rpx;
  width: 400rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
  box-sizing: border-box;
}
.layer-panel-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.layer-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
}
.layer-name { font-size: 28rpx; color: #333; }

/* 简易开关 */
.layer-switch {
  width: 84rpx;
  height: 46rpx;
  border-radius: 23rpx;
  background: #ddd;
  position: relative;
  transition: background 0.2s;
}
.switch-on { background: #07c160; }
.layer-dot {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}
.switch-on .layer-dot { transform: translateX(38rpx); }

.layer-done {
  margin-top: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #07c160;
  border-top: 1rpx solid #eee;
  padding-top: 20rpx;
}

/* 底部一行：搜索栏 + 发布按钮 */
.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 10;
}
.search-bar {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,0.96);
  border-radius: 42rpx;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.18);
}
.search-icon { font-size: 28rpx; line-height: 1; }
.search-text { font-size: 26rpx; color: #999; }

.publish-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  background: #07c160;
  color: #fff;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(7,193,96,0.4);
}
.publish-icon { font-size: 30rpx; line-height: 1; }

.empty-tip {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  top: 150rpx;
  background: rgba(0,0,0,0.7);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
  z-index: 10;
  white-space: nowrap;
}
