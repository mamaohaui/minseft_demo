.map { width: 100%; height: 100vh; }
.publish-btn {
  position: fixed;
  right: 30rpx;
  bottom: 60rpx;
  background: #07c160;
  color: #fff;
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  z-index: 10;
}

.map-ctrl {
  position: fixed;
  top: 30rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 30rpx;
  padding: 12rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  z-index: 10;
}
.top-left { left: 20rpx; }
.top-right { right: 20rpx; }
.ctrl-icon { font-size: 26rpx; color: #07c160; }

.empty-tip {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  top: 30rpx;
  background: rgba(0,0,0,0.7);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
  z-index: 10;
  white-space: nowrap;
}
