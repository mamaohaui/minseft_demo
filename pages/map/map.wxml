<map
  id="map"
  class="map"
  latitude="{{latitude}}"
  longitude="{{longitude}}"
  scale="16"
  min-scale="3"
  max-scale="20"
  enable-zoom
  enable-scroll
  markers="{{markers}}"
  show-location
  bindmarkertap="onMarkerTap"
  bindcallouttap="onMarkerTap"
  bindregionchange="onRegionChange"
/>

<!-- 顶部中间：地区选择器（选区后显示该地区周边公共摊点） -->
<picker mode="selector" range="{{regionNames}}" bindchange="onPickRegion">
  <view class="region-btn" hover-class="btn-pressed" hover-stay-time="80">
    <text class="region-icon">📍</text>
    <text class="region-text">{{regionName}}</text>
    <text class="region-caret">▾</text>
  </view>
</picker>

<!-- 左上角：定位 / 刷新（iOS 悬浮圆钮） -->
<view class="top-left-bar">
  <view class="ctrl-btn" hover-class="btn-pressed" hover-stay-time="80" bindtap="backToLocation">
    <text class="ctrl-icon">◎</text>
    <text class="ctrl-text">定位</text>
  </view>
  <view class="ctrl-btn" hover-class="btn-pressed" hover-stay-time="80" bindtap="refresh">
    <text class="ctrl-icon">⟳</text>
    <text class="ctrl-text">刷新</text>
  </view>
</view>

<!-- 右上角：图层按钮 -->
<view class="layer-btn" hover-class="btn-pressed" hover-stay-time="80" bindtap="toggleLayerPanel">
  <text class="layer-icon">▦</text>
  <text class="layer-text">图层</text>
</view>

<!-- 图层面板：再点图层按钮或点遮罩收回 -->
<view wx:if="{{layerPanelOpen}}" class="layer-mask" bindtap="closeLayerPanel">
  <view class="layer-panel" catchtap="noop">
    <view class="layer-panel-title">显示图层</view>
    <view class="layer-option" data-key="private" bindtap="toggleLayer">
      <text class="layer-name">我的私有</text>
      <view class="layer-switch {{layers.private ? 'switch-on' : ''}}"><view class="layer-dot"></view></view>
    </view>
    <view class="layer-option" data-key="followed" bindtap="toggleLayer">
      <text class="layer-name">关注分享</text>
      <view class="layer-switch {{layers.followed ? 'switch-on' : ''}}"><view class="layer-dot"></view></view>
    </view>
    <view class="layer-option" data-key="public" bindtap="toggleLayer">
      <text class="layer-name">公共摊点</text>
      <view class="layer-switch {{layers.public ? 'switch-on' : ''}}"><view class="layer-dot"></view></view>
    </view>
  </view>
</view>

<!-- 底部一行：搜索栏 + 发布（iOS 胶囊） -->
<view class="bottom-bar">
  <view class="search-bar" hover-class="bar-pressed" hover-stay-time="80" bindtap="goSearch">
    <text class="search-icon">🔍</text>
    <text class="search-text">搜索摆摊地点 / 分类</text>
  </view>
  <view class="publish-btn" hover-class="publish-pressed" hover-stay-time="80" bindtap="goPublish">
    <text class="publish-icon">＋</text>
    <text class="publish-text">发布地点</text>
  </view>
</view>

<view wx:if="{{loaded && markers.length === 0}}" class="empty-tip">
  当前地区暂无摊点，可换地区或发布第一个
</view>
