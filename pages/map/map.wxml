<map
  id="map"
  class="map"
  latitude="{{latitude}}"
  longitude="{{longitude}}"
  scale="16"
  min-scale="3"
  max-scale="20"
  enable-zoom
  enable-scroll
  markers="{{markers}}"
  show-location
  bindmarkertap="onMarkerTap"
  bindcallouttap="onMarkerTap"
  bindregionchange="onRegionChange"
/>

<!-- 左上角：定位 / 刷新 -->
<view class="top-left-bar">
  <view class="ctrl-btn" bindtap="backToLocation">
    <text class="ctrl-icon">◎</text>
    <text class="ctrl-text">定位</text>
  </view>
  <view class="ctrl-btn" bindtap="refresh">
    <text class="ctrl-icon">⟳</text>
    <text class="ctrl-text">刷新</text>
  </view>
</view>

<!-- 右上角：图层按钮 -->
<view class="layer-btn" bindtap="toggleLayerPanel">
  <text class="layer-icon">▦</text>
  <text class="layer-text">图层</text>
</view>

<!-- 图层面板：点遮罩或"完成"关闭 -->
<view wx:if="{{layerPanelOpen}}" class="layer-mask" bindtap="closeLayerPanel">
  <view class="layer-panel" catchtap="noop">
    <view class="layer-panel-title">显示图层</view>
    <view class="layer-option" data-key="public" bindtap="toggleLayer">
      <text class="layer-name">公开地点</text>
      <view class="layer-switch {{layers.public ? 'switch-on' : ''}}"><view class="layer-dot"></view></view>
    </view>
    <view class="layer-option" data-key="vip" bindtap="toggleLayer">
      <text class="layer-name">VIP 专属</text>
      <view class="layer-switch {{layers.vip ? 'switch-on' : ''}}"><view class="layer-dot"></view></view>
    </view>
    <view class="layer-option" data-key="private" bindtap="toggleLayer">
      <text class="layer-name">我的私有</text>
      <view class="layer-switch {{layers.private ? 'switch-on' : ''}}"><view class="layer-dot"></view></view>
    </view>
    <view class="layer-done" bindtap="closeLayerPanel">完成</view>
  </view>
</view>

<!-- 底部一行：搜索栏 + 发布 -->
<view class="bottom-bar">
  <view class="search-bar" bindtap="goSearch">
    <text class="search-icon">🔍</text>
    <text class="search-text">搜索摆摊地点 / 分类</text>
  </view>
  <view class="publish-btn" bindtap="goPublish">
    <text class="publish-icon">＋</text>
    <text class="publish-text">发布地点</text>
  </view>
</view>

<view wx:if="{{loaded && markers.length === 0}}" class="empty-tip">
  附近还没有摆摊点，点下方发布第一个吧！
</view>
