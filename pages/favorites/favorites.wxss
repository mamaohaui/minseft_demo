.container { padding: 24rpx 32rpx 48rpx; }
.empty { color: #8e8e93; font-size: 27rpx; text-align: center; padding: 120rpx 0; }

.fav-item {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}

/* 主行：名称 + 操作按钮同行 */
.fav-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.t {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.acts { display: flex; align-items: center; flex-shrink: 0; }
/* iOS 色调浅底胶囊 */
.act {
  font-size: 25rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  margin-left: 12rpx;
  transition: opacity 0.12s ease;
}
.act-pressed { opacity: 0.5; }
.act-view { background: rgba(0,122,255,0.12); color: #007aff; }
.act-del { background: rgba(255,59,48,0.12); color: #ff3b30; }

/* 次行：品类 + 发布者 */
.meta-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  gap: 12rpx;
}
.cat { font-size: 24rpx; color: #8e8e93; }
.creator { font-size: 24rpx; color: #8e8e93; }
