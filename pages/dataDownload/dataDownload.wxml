<view class="page">
  <!-- 说明卡 -->
  <view class="tip-card">
    <view class="tip-title">⬇︎ 公共摆摊数据库</view>
    <view class="tip-text">这里是官方收集整理的公共摆摊基础数据（早市 / 夜市 / 农贸市场 / 批发市场等），按省 / 市 / 县下载，可整市一键下载或按区县单独下载。下载后地图「公共摊点」图层才会显示对应区域；你自己的发布、收藏和关注的地点不受影响、无需下载。</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{tree.length === 0}}" class="empty">公共数据库为空：请先在开发者工具中部署 seedSpots 云函数，再重新进入本页（将自动初始化基础数据）</view>

  <!-- 省 → 市 → 县三级层级（默认展开） -->
  <block wx:for="{{tree}}" wx:key="province" wx:for-item="prov" wx:for-index="pi">
    <view class="section-title" hover-class="title-pressed" hover-stay-time="60" bindtap="toggleProvince" data-i="{{pi}}">
      <text>{{prov.province}}</text>
      <text class="expand-icon">{{prov.expanded ? '▾' : '▸'}}</text>
    </view>

    <view wx:if="{{prov.expanded}}" class="group-card">
      <block wx:for="{{prov.cities}}" wx:key="city" wx:for-item="city" wx:for-index="ci">
        <view class="city-row {{ci > 0 ? 'row-divider' : ''}}" hover-class="row-pressed" hover-stay-time="60" bindtap="toggleCity" data-pi="{{pi}}" data-ci="{{ci}}">
          <view class="city-info">
            <view class="city-name">{{city.city}}</view>
            <view class="city-sub">{{city.districts.length}} 个区县 · {{city.total}} 个摊点{{city.downloadedCount ? ' · 已下载 ' + city.downloadedCount + '/' + city.districts.length : ''}}</view>
          </view>
          <view wx:if="{{!city.allDownloaded}}" class="dl-btn dl-mini" hover-class="btn-pressed" hover-stay-time="60"
                catchtap="downloadCity" data-pi="{{pi}}" data-ci="{{ci}}">
            全部下载
          </view>
          <view wx:else class="dl-btn dl-remove dl-mini" hover-class="btn-pressed" hover-stay-time="60"
                catchtap="removeCity" data-pi="{{pi}}" data-ci="{{ci}}">
            全部删除
          </view>
          <text class="expand-icon">{{city.expanded ? '▾' : '▸'}}</text>
        </view>

        <block wx:if="{{city.expanded}}">
          <view wx:for="{{city.districts}}" wx:key="district" wx:for-item="d" class="dist-row row-divider">
            <view class="dist-info">
              <view class="dist-name">{{d.district}}</view>
              <view class="dist-sub">{{d.count}} 个摊点{{d.downloaded ? ' · 已下载' : ''}}</view>
            </view>
            <view wx:if="{{!d.downloaded}}" class="dl-btn" hover-class="btn-pressed" hover-stay-time="60"
                  bindtap="download" data-key="{{d.key}}" data-province="{{d.province}}" data-city="{{d.city}}" data-district="{{d.district}}">
              下载
            </view>
            <view wx:else class="dl-btn dl-remove" hover-class="btn-pressed" hover-stay-time="60"
                  bindtap="remove" data-key="{{d.key}}">
              删除
            </view>
          </view>
        </block>
      </block>
    </view>
  </block>
</view>
