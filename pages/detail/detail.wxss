.container { padding: 24rpx; }
.title { font-size: 40rpx; font-weight: bold; margin-bottom: 20rpx; }
.row { font-size: 28rpx; color: #333; margin: 12rpx 0; }
.pending-tip { color: #e64340; font-size: 26rpx; margin: 12rpx 0; }
.btns { margin: 20rpx 0; display: flex; gap: 16rpx; }
.section-title { font-size: 32rpx; font-weight: bold; margin: 30rpx 0 16rpx; }
.empty { color: #999; font-size: 26rpx; }
.review { border-bottom: 1rpx solid #eee; padding: 16rpx 0; font-size: 26rpx; }
.tags { color: #07c160; font-size: 24rpx; }
