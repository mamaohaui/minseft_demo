.container { padding: 24rpx; }
.title { font-size: 40rpx; font-weight: bold; margin-bottom: 20rpx; }
.row { font-size: 28rpx; color: #333; margin: 12rpx 0; }
.pending-tip { color: #e64340; font-size: 26rpx; margin: 12rpx 0; }
.btns { margin: 20rpx 0; display: flex; gap: 16rpx; }
.section-title { font-size: 32rpx; font-weight: bold; margin: 30rpx 0 16rpx; }
.empty { color: #999; font-size: 26rpx; }
.review { border-bottom: 1rpx solid #eee; padding: 16rpx 0; font-size: 26rpx; }
.review-head { display: flex; gap: 12rpx; }
.review-star { color: #ff9f0a; font-weight: bold; }
.review-content { color: #333; }
.tags { color: #07c160; font-size: 24rpx; margin-top: 6rpx; }

/* 评价表单 */
.review-form { background: #f7f7f7; border-radius: 12rpx; padding: 20rpx; margin-bottom: 10rpx; }
.stars { display: flex; align-items: center; gap: 8rpx; margin-bottom: 16rpx; }
.star { font-size: 44rpx; color: #ddd; line-height: 1; padding: 0 4rpx; }
.star.on { color: #ff9f0a; }
.stars-tip { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.tag { font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 24rpx; background: #fff; color: #666; border: 1rpx solid #eee; }
.tag.on { background: #e8f7ee; color: #07c160; border-color: #07c160; }
.review-input { width: 100%; min-height: 120rpx; background: #fff; border-radius: 8rpx; padding: 12rpx; box-sizing: border-box; font-size: 26rpx; margin-bottom: 16rpx; }
.submit-btn { margin: 0; }
.reviewed-bar { display: flex; justify-content: space-between; align-items: center; background: #f7f7f7; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: #666; }
.reviewed-edit { color: #07c160; margin-left: 20rpx; }
