.container { padding: 24rpx 32rpx 64rpx; }

/* ===== 大标题区（iOS large title） ===== */
.hero { padding: 16rpx 8rpx 8rpx; }
.title { font-size: 44rpx; font-weight: 700; color: #1c1c1e; letter-spacing: 1rpx; }
.hero-sub { font-size: 25rpx; color: #8e8e93; margin-top: 12rpx; }

/* ===== 信息分组卡（iOS 键值行） ===== */
.info-card {
  margin-top: 28rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 26rpx 32rpx;
}
.row-divider { border-top: 1rpx solid rgba(60,60,67,0.12); }
.info-label { font-size: 28rpx; color: #8e8e93; flex-shrink: 0; }
.info-value { font-size: 28rpx; color: #1c1c1e; text-align: right; flex: 1; }
.value-accent { color: #ff9500; font-weight: 600; }

.pending-tip {
  color: #c93400;
  font-size: 26rpx;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(255,149,0,0.12);
  border-radius: 18rpx;
}

/* ===== 操作按钮（iOS 胶囊） ===== */
.btns { margin: 32rpx 0; display: flex; gap: 16rpx; }
.pill {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border-radius: 24rpx;
  transition: all 0.12s ease;
}
.pill-fill {
  color: #fff;
  background: #34c759;
  box-shadow: 0 4rpx 14rpx rgba(52,199,89,0.3);
}
.pill-fill-pressed { background: #2db350; opacity: 0.85; }
.pill-line {
  color: #007aff;
  background: rgba(0,122,255,0.08);
  border: 1rpx solid rgba(0,122,255,0.4);
}
.pill-danger {
  color: #ff3b30;
  background: rgba(255,59,48,0.08);
  border: 1rpx solid rgba(255,59,48,0.4);
}
.pill-pressed { opacity: 0.5; }
.link-pressed { opacity: 0.4; }

/* ===== 分节标题（iOS 节标题） ===== */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 2rpx;
  margin: 40rpx 8rpx 16rpx;
}
.empty { color: #8e8e93; font-size: 26rpx; padding: 40rpx 0; text-align: center; }

/* ===== 评价区（分组卡） ===== */
.review-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  overflow: hidden;
  padding: 8rpx 32rpx;
}
.review { padding: 24rpx 0; font-size: 26rpx; }
.review-divider { border-top: 1rpx solid rgba(60,60,67,0.12); }
.review-head { display: flex; gap: 12rpx; }
.review-star { color: #ff9500; font-weight: 600; }
.review-content { color: #1c1c1e; }
.tags { color: #248a3d; font-size: 24rpx; margin-top: 8rpx; }

/* 评价表单 */
.review-form {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  padding: 28rpx;
  margin-bottom: 12rpx;
}
.stars { display: flex; align-items: center; gap: 8rpx; margin-bottom: 20rpx; }
.star { font-size: 48rpx; color: rgba(120,120,128,0.28); line-height: 1; padding: 8rpx 6rpx; margin: -8rpx -6rpx; }
.star.on { color: #ff9500; }
.stars-tip { font-size: 24rpx; color: #8e8e93; margin-left: 8rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(120,120,128,0.12);
  color: #3c3c43;
  transition: all 0.15s ease;
}
.tag.on { background: #34c759; color: #fff; font-weight: 500; }
.review-input {
  width: 100%;
  min-height: 140rpx;
  background: #f2f2f7;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  margin-bottom: 20rpx;
}
.submit-btn {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #34c759;
  border-radius: 24rpx;
  padding: 20rpx 0;
  box-shadow: 0 4rpx 14rpx rgba(52,199,89,0.3);
  transition: all 0.12s ease;
}
.reviewed-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  padding: 24rpx 28rpx;
  font-size: 27rpx;
  color: #3c3c43;
}
.reviewed-edit { color: #007aff; font-weight: 500; }
