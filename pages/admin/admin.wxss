.container { padding: 24rpx 32rpx 48rpx; }
.empty { text-align: center; color: #8e8e93; padding: 120rpx 0; font-size: 27rpx; }

.item {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.t { font-size: 30rpx; font-weight: 600; color: #1c1c1e; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.s { color: #8e8e93; font-size: 26rpx; margin: 12rpx 0 4rpx; }
.tag { flex-shrink: 0; font-size: 22rpx; font-weight: 500; padding: 4rpx 16rpx; border-radius: 12rpx; }
.tag-update { background: rgba(0,122,255,0.12); color: #007aff; }
.tag-new { background: rgba(255,149,0,0.14); color: #c93400; }

/* 操作按钮：iOS 胶囊 */
.btns { margin-top: 24rpx; display: flex; gap: 16rpx; }
.btn {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  padding: 16rpx 0;
  border-radius: 22rpx;
  transition: all 0.12s ease;
}
.btn-view {
  color: #007aff;
  background: rgba(0,122,255,0.10);
  border: 1rpx solid rgba(0,122,255,0.4);
}
.btn-approve {
  color: #fff;
  background: #34c759;
  box-shadow: 0 4rpx 14rpx rgba(52,199,89,0.3);
}
.btn-reject {
  color: #ff3b30;
  background: rgba(255,59,48,0.10);
}
.btn-pressed { opacity: 0.5; }
.btn-fill-pressed { background: #2db350; opacity: 0.85; }
