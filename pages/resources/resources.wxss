.page {
  min-height: 100vh;
  background: #f2f2f7;
  box-sizing: border-box;
}

/* ===== 开发中占位 ===== */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 64rpx 0;
}
.placeholder-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #34c759, #30d158);
  box-shadow: 0 12rpx 32rpx rgba(52,199,89,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-icon-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}
.placeholder-badge {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #ff9500;
  background: rgba(255,149,0,0.14);
  border-radius: 12rpx;
  padding: 6rpx 20rpx;
}
.placeholder-title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1c1e;
}
.placeholder-sub {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #8e8e93;
  line-height: 1.7;
  text-align: center;
}
