.page { padding: 24rpx 32rpx 200rpx; }

/* ===== 分类筛选条（iOS 筛选 chips） ===== */
.cats {
  white-space: nowrap;
  margin-bottom: 28rpx;
}
.cat {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background: #fff;
  color: #3c3c43;
  font-size: 26rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.15s ease;
}
.cat-active {
  background: #34c759;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(52,199,89,0.35);
}
.chip-pressed { opacity: 0.6; }

.tip { text-align: center; color: #8e8e93; font-size: 27rpx; padding: 120rpx 0; }
.list-scroll { height: calc(100vh - 180rpx); }
.load-more { padding: 40rpx 0 120rpx; font-size: 24rpx; }

/* ===== 资源卡片 ===== */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  transition: transform 0.12s ease;
}
.card-pressed { transform: scale(0.98); }
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.card-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #1c1c1e;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-tag {
  flex-shrink: 0;
  background: rgba(52,199,89,0.14);
  color: #248a3d;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}
.card-content {
  font-size: 27rpx;
  color: #3c3c43;
  line-height: 1.65;
  margin-top: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(60,60,67,0.12);
}
.card-time { font-size: 22rpx; color: #c7c7cc; }
.card-contact {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 60%;
}
.contact-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #007aff;
  border: 1rpx solid rgba(0,122,255,0.5);
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
}
.contact-value {
  font-size: 24rpx;
  color: #1c1c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.link-pressed { opacity: 0.4; }

/* ===== 发布资源悬浮按钮（iOS 胶囊） ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(50rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #34c759;
  color: #fff;
  padding: 24rpx 40rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx rgba(52,199,89,0.4);
  z-index: 10;
  transition: transform 0.12s ease;
}
.fab-icon { font-size: 32rpx; line-height: 1; }
.fab-pressed { transform: scale(0.95); background: #2db350; }
