<view class="page">
  <!-- 用户卡 -->
  <view class="user-card">
    <view class="avatar">摊</view>
    <view class="user-info">
      <view class="user-name">摆摊摊友</view>
      <view class="user-role {{user && user.isAdmin ? 'role-admin' : ''}}">
        {{user ? (user.isAdmin ? '管理员' : '普通用户') : '身份加载中…'}}
      </view>
    </view>
  </view>

  <!-- 发布管理 -->
  <view class="section">
    <view class="section-title">发布管理</view>
    <view class="entry-row" bindtap="goMySpots">
      <view class="entry-left">
        <view class="entry-name">我的发布</view>
        <view class="entry-sub" wx:if="{{mySpots.length}}">共 {{mySpots.length}} 条记录</view>
        <view class="entry-sub" wx:else>暂无发布，去地图右下角发布第一个摊点</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{user && user.isAdmin}}" class="entry-row" bindtap="goAdmin">
      <view class="entry-left">
        <view class="entry-name">管理员审核</view>
        <view class="entry-sub">审核摊友提交的地点申请</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="section">
    <view class="section-title">
      我的收藏
      <text class="count" wx:if="{{favorites.length}}">{{favorites.length}}</text>
    </view>
    <view wx:if="{{favorites.length === 0}}" class="empty-card">暂无收藏，去地图逛逛吧</view>
    <view wx:for="{{favorites}}" wx:key="_id" class="fav-card" data-id="{{item._id}}" bindtap="goDetail">
      <view class="fav-main">
        <view class="fav-title">{{item.current ? item.current.title : '（待公开）'}}</view>
        <view class="fav-sub">{{item.current ? item.current.category : '—'}}</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
