<view class="container">
  <view class="header">角色：{{user ? user.role : '...'}}</view>

  <!-- 我的发布 -->
  <view class="section-title">
    我的发布
    <text class="add-link" bindtap="goPublish">+ 发布新地点</text>
  </view>
  <view wx:if="{{mySpots.length === 0}}" class="empty">还没有发布过地点，点右上角发布一个吧～</view>
  <view wx:for="{{mySpots}}" wx:key="_id" class="spot-item" data-id="{{item._id}}" bindtap="goSpot">
    <view class="spot-row">
      <text class="t">{{item._title}}</text>
      <text class="badge badge-{{item._status}}">{{item._statusText}}</text>
    </view>
    <view wx:if="{{item.rejectReason}}" class="reject-reason">驳回原因：{{item.rejectReason}}</view>
    <view class="s">可见性：{{item.visibility === 'public' ? '公开' : (item.visibility === 'vip' ? 'VIP' : '私人')}}</view>
    <view class="spot-actions">
      <text class="link" data-id="{{item._id}}" catchtap="goDetail">查看</text>
      <text class="link" data-id="{{item._id}}" catchtap="goEdit">{{item._status === 'approved' && !item.hasPendingUpdate ? '编辑' : '修改重提'}}</text>
    </view>
  </view>

  <view class="section-title">我的收藏</view>
  <view wx:if="{{favorites.length === 0}}" class="empty">暂无收藏</view>
  <view wx:for="{{favorites}}" wx:key="_id" class="item" data-id="{{item._id}}" bindtap="goDetail">
    <view class="t">{{item.current ? item.current.title : '（待公开）'}}</view>
    <view class="s">{{item.current ? item.current.category : '—'}}</view>
  </view>

  <button wx:if="{{user && user.isAdmin}}" class="admin-btn" bindtap="goAdmin">管理员审核</button>
</view>
