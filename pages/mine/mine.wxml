<view class="page">
  <!-- 个人信息入口：头像 + 昵称（游客/名字）+ 未完善提示，点击进入填写/编辑 -->
  <view class="section-title">个人信息</view>
  <view class="group-card">
    <view class="entry-row profile-row" hover-class="row-pressed" hover-stay-time="80" bindtap="goRegister">
      <image wx:if="{{user && user.avatarUrl}}" class="profile-avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="profile-avatar">{{avatarChar}}</view>
      <view class="entry-left">
        <view class="entry-name profile-name">
          {{displayName}}
          <text wx:if="{{!profileCompleted}}" class="badge">未完善</text>
        </view>
        <view class="entry-sub">{{roleText}}</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 发布管理：我的发布 + 我的收藏 + 公共数据下载（iOS 分组列表，同一卡片 + 发丝线分隔） -->
  <view class="section-title">发布管理</view>
  <view class="group-card">
    <view class="entry-row" hover-class="row-pressed" hover-stay-time="80" bindtap="goMySpots">
      <view class="entry-left">
        <view class="entry-name">我的发布</view>
        <view class="entry-sub" wx:if="{{mySpots.length}}">共 {{mySpots.length}} 条记录</view>
        <view class="entry-sub" wx:else>暂无发布，去地图发布第一个摊点</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="entry-row row-divider" hover-class="row-pressed" hover-stay-time="80" bindtap="goFavorites">
      <view class="entry-left">
        <view class="entry-name">我的收藏</view>
        <view class="entry-sub" wx:if="{{favorites.length}}">共 {{favorites.length}} 个收藏地点</view>
        <view class="entry-sub" wx:else>暂无收藏，看到心仪摊点就收藏吧</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="entry-row row-divider" hover-class="row-pressed" hover-stay-time="80" bindtap="goDataDownload">
      <view class="entry-left">
        <view class="entry-name">公共数据下载</view>
        <view class="entry-sub" wx:if="{{offlineCount}}">已下载 {{offlineCount}} 个区域数据包</view>
        <view class="entry-sub" wx:else>按省 / 市 / 县下载公共摊点数据包</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 管理员审核：单独分组，放在下面（仅管理员可见） -->
  <block wx:if="{{user && user.isAdmin}}">
    <view class="section-title">管理员</view>
    <view class="group-card">
      <view class="entry-row" hover-class="row-pressed" hover-stay-time="80" bindtap="goAdmin">
        <view class="entry-left">
          <view class="entry-name">管理员审核</view>
          <view class="entry-sub">审核摊友提交的地点申请</view>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="entry-row row-divider" hover-class="row-pressed" hover-stay-time="80" bindtap="goDataManage">
        <view class="entry-left">
          <view class="entry-name">数据管理</view>
          <view class="entry-sub">可视化编辑/删除云端点位（基础库与用户发布）</view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </block>
</view>
