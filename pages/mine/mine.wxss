.container { padding: 24rpx; }
.header { font-size: 32rpx; font-weight: bold; padding: 20rpx 0; }
.section-title { font-size: 30rpx; font-weight: bold; margin: 24rpx 0 12rpx; display: flex; justify-content: space-between; align-items: center; }
.add-link { font-size: 24rpx; font-weight: normal; color: #07c160; }
.empty { color: #999; font-size: 26rpx; }
.item { padding: 20rpx 0; border-bottom: 1rpx solid #eee; }
.t { font-size: 30rpx; }
.s { color: #999; font-size: 24rpx; margin-top: 4rpx; }
.admin-btn { margin-top: 40rpx; }

/* 我的发布 */
.spot-item { padding: 20rpx 0; border-bottom: 1rpx solid #eee; }
.spot-row { display: flex; justify-content: space-between; align-items: center; }
.badge { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-left: 12rpx; flex-shrink: 0; }
.badge-approved { background: #e8f7ee; color: #07c160; }
.badge-pending { background: #fff7e6; color: #ff9900; }
.badge-updating { background: #e6f0ff; color: #3b7dff; }
.badge-rejected { background: #ffeceb; color: #e64340; }
.reject-reason { color: #e64340; font-size: 24rpx; margin-top: 8rpx; }
.spot-actions { margin-top: 12rpx; display: flex; gap: 30rpx; }
.link { color: #576b95; font-size: 24rpx; }
