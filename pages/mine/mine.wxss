.page { padding: 24rpx 32rpx 48rpx; }

/* ===== 个人信息栏：头像 + 昵称（游客/名字） ===== */
.profile-row {
  padding: 26rpx 32rpx;
}
.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34c759, #30d158);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(52,199,89,0.3);
  flex-shrink: 0;
  margin-right: 24rpx;
}
.name-edit { font-size: 22rpx; font-weight: 400; color: #007aff; margin-left: 12rpx; }
.profile-name { font-size: 34rpx; font-weight: 600; color: #1c1c1e; }

/* ===== 分组标题（iOS 节标题：小号灰字 + 字距） ===== */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 2rpx;
  margin: 40rpx 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.count {
  font-size: 22rpx;
  color: #34c759;
  background: rgba(52,199,89,0.14);
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
}

/* ===== 分组卡片（iOS inset grouped list） ===== */
.group-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.row-divider { border-top: 1rpx solid rgba(60,60,67,0.12); }

/* 入口行 */
.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
}
.entry-left { display: flex; flex-direction: column; gap: 8rpx; }
.entry-name { font-size: 31rpx; font-weight: 500; color: #1c1c1e; }
.entry-sub { font-size: 24rpx; color: #8e8e93; }

/* 未完善标记 */
.badge {
  font-size: 20rpx;
  font-weight: 400;
  color: #fff;
  background: #ff9500;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.arrow { font-size: 40rpx; color: #c7c7cc; line-height: 1; font-weight: 300; }

/* 按下态（iOS 高亮灰） */
.row-pressed { background: rgba(60,60,67,0.06); }
