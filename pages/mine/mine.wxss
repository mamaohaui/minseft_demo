.page { padding: 24rpx 32rpx 48rpx; }

/* ===== 用户卡（大圆角 + 柔和阴影） ===== */
.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  transition: transform 0.12s ease;
}
.card-pressed { transform: scale(0.98); }
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34c759, #30d158);
  color: #fff;
  font-size: 42rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(52,199,89,0.3);
}
.user-info { display: flex; flex-direction: column; gap: 10rpx; flex: 1; min-width: 0; }
.user-name { font-size: 34rpx; font-weight: 600; color: #1c1c1e; display: flex; align-items: center; gap: 12rpx; }
.name-edit { font-size: 22rpx; font-weight: 400; color: #007aff; flex-shrink: 0; }
.user-hint { font-size: 22rpx; color: #c7c7cc; }
.user-role {
  align-self: flex-start;
  font-size: 22rpx;
  color: #8e8e93;
  background: rgba(120,120,128,0.12);
  border-radius: 12rpx;
  padding: 4rpx 16rpx;
}
.role-admin {
  color: #ff9500;
  background: rgba(255,149,0,0.14);
}

/* ===== 分组标题（iOS 节标题：小号灰字 + 字距） ===== */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 2rpx;
  margin: 40rpx 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.count {
  font-size: 22rpx;
  color: #34c759;
  background: rgba(52,199,89,0.14);
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
}

/* ===== 分组卡片（iOS inset grouped list） ===== */
.group-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.row-divider { border-top: 1rpx solid rgba(60,60,67,0.12); }

/* 入口行 */
.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
}
.entry-left { display: flex; flex-direction: column; gap: 8rpx; }
.entry-name { font-size: 31rpx; font-weight: 500; color: #1c1c1e; }
.entry-sub { font-size: 24rpx; color: #8e8e93; }

/* 未完善标记 */
.badge {
  font-size: 20rpx;
  font-weight: 400;
  color: #fff;
  background: #ff9500;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.arrow { font-size: 40rpx; color: #c7c7cc; line-height: 1; font-weight: 300; }

/* 按下态（iOS 高亮灰） */
.row-pressed { background: rgba(60,60,67,0.06); }
